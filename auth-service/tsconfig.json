{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
  },
  "include": [
    "src/**/*.ts",
    "src/generated/**/*.js",
    "src/generated/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "files": [
    "src/types/index.d.ts"
  ]
}
